{
  "version": 2,
  "public": true,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/login", "dest": "/public/auth/login.html" },
    { "src": "/register", "dest": "/public/auth/register.html" },
    { "src": "/firmware", "dest": "/public/webapps/firmware/index.html" },
    { "src": "/schematic", "dest": "/public/webapps/schematic/index.html" },
    { "src": "/tools", "dest": "/public/webapps/tools/index.html" },
    { "src": "/tutorial", "dest": "/public/webapps/tutorial/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}