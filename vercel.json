{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/firmware",
      "destination": "/webapps/firmware/firmware.html"
    },
    {
      "source": "/schematic",
      "destination": "/webapps/schematic/schematic.html"
    },
    {
      "source": "/tools",
      "destination": "/webapps/tools/tools.html"
    },
    {
      "source": "/login",
      "destination": "/auth/login.html"
    },
    {
      "source": "/register",
      "destination": "/auth/register.html"
    }
  ]
}